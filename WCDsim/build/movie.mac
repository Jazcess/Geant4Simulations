# --- INITIALIZATION ---
/vis/viewer/clearVisActionModifiers
/vis/viewer/reset
/vis/scene/add/trajectories rich
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setTimeSliceInterval 0.01 ns

# --- ZOOM & FOCUS SETTINGS ---
/vis/viewer/set/targetPoint 0 45 0 cm

# Increase zoom significantly to see the PMT detail
/vis/viewer/zoom 5.0

# --- GENERATE EVENT ---
/run/beamOn 1

# --- VISUAL SETTINGS ---
/vis/viewer/set/timeWindow/displayHeadTime true
/vis/viewer/set/timeWindow/fadeFactor 5

# --- FRAME GENERATION (Expanding Window) ---
# Logic: Start time is fixed at 0ns, Window Width increments 1-50ns

/vis/viewer/set/timeWindow/startTime 0 ns 1 ns
/vis/viewer/save
/vis/viewer/set/timeWindow/startTime 0 ns 2 ns
/vis/viewer/save
/vis/viewer/set/timeWindow/startTime 0 ns 3 ns
/vis/viewer/save
/vis/viewer/set/timeWindow/startTime 0 ns 4 ns
/vis/viewer/save
