/vis/open OGL 1920x1080-0+0
/vis/viewer/set/viewpointVector 10 0 0
/vis/viewer/set/background white
/vis/viewer/set/lineSegmentsPerCircle 100
/vis/drawVolume

/vis/geometry/set/colour logicWater 0 0.9 0.9 0.95 0.15
/vis/geometry/set/forceSolid logicWater 0 true

/vis/geometry/set/colour logicWLS 0 0.4 0.0 1.0 0.3
/vis/geometry/set/forceSolid logicWLS 0 true

/vis/geometry/set/colour logicPMTSphere 0 0.5 0.8 1.0 1.0
/vis/geometry/set/forceSolid logicPMTSphere 0 true

/vis/geometry/set/colour logicSideMirrorX 0 0.7 0.7 0.7 0.5
/vis/geometry/set/forceWireframe logicSideMirrorX 0 true

/vis/geometry/set/colour logicSideMirrorZ 0 0.7 0.7 0.7 0.5
/vis/geometry/set/forceWireframe logicSideMirrorZ 0 true

/vis/geometry/set/colour logicTopMirror 0 0.7 0.7 0.7 0.5
/vis/geometry/set/forceWireframe logicTopMirror 0 true

/vis/geometry/set/colour logicLiner 0 0.3 0.3 0.3 1.0
/vis/geometry/set/forceWireframe logicLiner 0 true

/vis/viewer/set/autoRefresh true
/vis/scene/add/trajectories smooth

/vis/scene/add/eventID
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/hiddenMarker true
/vis/viewer/set/viewpointThetaPhi 0 180
/vis/viewer/zoom 2
/vis/verbose 2

/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set e- yellow
/vis/modeling/trajectories/drawByParticleID-0/set e+ yellow
/vis/modeling/trajectories/drawByParticleID-0/set mu- green
/vis/modeling/trajectories/drawByParticleID-0/set mu+ green
/vis/modeling/trajectories/drawByParticleID-0/set gamma blue
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton red

/vis/filtering/trajectories/create/particleFilter
/vis/filtering/trajectories/particleFilter-0/add e-
/vis/filtering/trajectories/particleFilter-0/add e+
/vis/filtering/trajectories/particleFilter-0/add mu-
/vis/filtering/trajectories/particleFilter-0/add mu+
/vis/filtering/trajectories/particleFilter-0/add gamma
/vis/filtering/trajectories/particleFilter-0/add opticalphoton

/vis/filtering/trajectories/create/originVolumeFilter
/vis/filtering/trajectories/originVolumeFilter-0/add logicWLS
